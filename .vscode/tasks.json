{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: dev:full",
            "type": "shell",
            "command": "npm run dev:full",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [
                {
                    "base": "$tsc",
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*starting development servers.*",
                        "endsPattern": ".*servers started successfully.*"
                    }
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Start Node API",
            "type": "shell",
            "command": "npm run server",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Server starting.*",
                        "endsPattern": ".*Server running on port 8065.*"
                    }
                }
            ]
        },
        {
            "label": "Start React Client",
            "type": "shell",
            "command": "npm run client",
            "group": "build",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Vite dev server starting.*",
                        "endsPattern": ".*Local: http://localhost:5173.*"
                    }
                }
            ]
        },
        {
            "label": "Kill All Ports",
            "type": "shell",
            "command": "npx kill-port 5173 8065 9222 9229",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always"
            }
        }
    ]
}